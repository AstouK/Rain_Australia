    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5), sharey=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plot_cloud_rate(axes[0], df_eda, \\\"Cloud9am\\\", \\\"RainTomorrow Rate by Cloud at 9am\\\")\\n\",\n",
