    "    \"    loc_rate,\\n\",\n",
    "    \"    x_col=\\\"Location\\\",\\n\",\n",
    "    \"    rate_col=\\\"rain_rate\\\",\\n\",\n",
    "    \"    title=\\\"RainTomorrow Rate by Location (Top 15)\\\",\\n\",\n",
    "    \"    xlabel=\\\"Location\\\",\\n\",\n",
    "    \"    rotate=45,\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"1f6670f4070fa73b\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"##### RainTomorrow rate (%) by location\",\n",
    "   \"id\": \"f3ee69c2a4a544d7\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"df_rt_by_location = (\\n\",\n",
    "    \"    df_eda[[\\\"Location\\\", \\\"RainTomorrow_bin\\\"]]\\n\",\n",
    "    \"    .dropna()\\n\",\n",
    "    \"    .groupby(\\\"Location\\\", as_index=False)[\\\"RainTomorrow_bin\\\"]\\n\",\n",
    "    \"    .mean()\\n\",\n",
    "    \")\\n\",\n",
    "    \"df_rt_by_location[\\\"RainTomorrow_pct\\\"] = df_rt_by_location[\\\"RainTomorrow_bin\\\"] * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_rt_by_location = df_rt_by_location.merge(\\n\",\n",
    "    \"    df_geocodes[[\\\"Location\\\", \\\"Latitude\\\", \\\"Longitude\\\"]],\\n\",\n",
    "    \"    on=\\\"Location\\\",\\n\",\n",
    "    \"    how=\\\"left\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_rt_by_location_clean = df_rt_by_location.dropna(subset=[\\\"Latitude\\\", \\\"Longitude\\\"]).copy()\\n\",\n",
    "    \"df_rt_by_location_clean.head()\"\n",
    "   ],\n",
    "   \"id\": \"feaa5790935bdc32\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"# Bubble map (size encodes RainTomorrow rate)\\n\",\n",
    "    \"df_map = df_rt_by_location_clean.copy()\\n\",\n",
    "    \"df_map[\\\"popup\\\"] = df_map.apply(\\n\",\n",
    "    \"    lambda r: f\\\"{r['Location']}<br>RainTomorrow: {r['RainTomorrow_pct']:.1f}%\\\",\\n\",\n",
    "    \"    axis=1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"folium_bubble_map(\\n\",\n",
    "    \"    df_map,\\n\",\n",
    "    \"    lat_col=\\\"Latitude\\\",\\n\",\n",
    "    \"    lon_col=\\\"Longitude\\\",\\n\",\n",
    "    \"    size_col=\\\"RainTomorrow_pct\\\",\\n\",\n",
    "    \"    popup_col=\\\"popup\\\",\\n\",\n",
    "    \")\"\n",
    "   ],\n",
    "   \"id\": \"8d337c078ae27161\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"# Optional: color-encoded markers (fixed radius; color encodes %)\\n\",\n",
    "    \"import branca.colormap as cm\\n\",\n",
    "    \"\\n\",\n",
    "    \"colormap = cm.LinearColormap(\\n\",\n",
    "    \"    colors=[\\\"green\\\", \\\"yellow\\\", \\\"red\\\"],\\n\",\n",
    "    \"    vmin=df_rt_by_location_clean[\\\"RainTomorrow_pct\\\"].min(),\\n\",\n",
    "    \"    vmax=df_rt_by_location_clean[\\\"RainTomorrow_pct\\\"].max(),\\n\",\n",
    "    \")\\n\",\n",
    "    \"colormap.caption = \\\"RainTomorrow (%)\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"m = folium.Map(location=[-25.2744, 133.7751], zoom_start=5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for _, r in df_rt_by_location_clean.iterrows():\\n\",\n",
    "    \"    pct = float(r[\\\"RainTomorrow_pct\\\"])\\n\",\n",
    "    \"    folium.CircleMarker(\\n\",\n",
    "    \"        location=[float(r[\\\"Latitude\\\"]), float(r[\\\"Longitude\\\"])],\\n\",\n",
    "    \"        radius=8,\\n\",\n",
    "    \"        color=colormap(pct),\\n\",\n",
    "    \"        fill=True,\\n\",\n",
    "    \"        fill_color=colormap(pct),\\n\",\n",
    "    \"        fill_opacity=0.85,\\n\",\n",
    "    \"        popup=f\\\"{r['Location']}<br>RainTomorrow: {pct:.1f}%\\\",\\n\",\n",
    "    \"    ).add_to(m)\\n\",\n",
    "    \"\\n\",\n",
    "    \"colormap.add_to(m)\\n\",\n",
    "    \"m\"\n",
    "   ],\n",
    "   \"id\": \"e59b305ea2567431\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"##### Rain Tomorrow Rate by Wind\",\n",
    "   \"id\": \"6294ff3422fa5bcf\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(18, 6), subplot_kw={\\\"projection\\\": \\\"polar\\\"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"polar_rain_rate(axes[0], df_eda, \\\"WindGustDir\\\", WIND_DIR_ORDER, \\\"RainTomorrow Rate by WindGustDir\\\")\\n\",\n",
    "    \"polar_rain_rate(axes[1], df_eda, \\\"WindDir9am\\\",  WIND_DIR_ORDER, \\\"RainTomorrow Rate by WindDir9am\\\")\\n\",\n",
    "    \"polar_rain_rate(axes[2], df_eda, \\\"WindDir3pm\\\",  WIND_DIR_ORDER, \\\"RainTomorrow Rate by WindDir3pm\\\")\\n\",\n",
    "    \"\\n\",\n",
