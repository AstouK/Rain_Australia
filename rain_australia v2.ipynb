    "   \"source\": [\n",
    "    \"# Nils Becker (03817505)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Function for boxplot matrix,\\n\",\n",
    "    \"def boxplot_matrix(df, nCols, nRows):\\n\",\n",
    "    \"    num = df_eda[numerical_features] # Only keeps numerical features, since boxplots are not for ordinal data.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(8 * nCols, 6 * nRows)) # Creates dimensions for figure size dependent from matrix size.\\n\",\n",
    "    \"    for i, col in enumerate(num.columns, 1):\\n\",\n",
    "    \"        plt.subplot(nRows, nCols, i) # Creates one boxplot in each subplot.\\n\",\n",
    "    \"        plt.boxplot(num[col].dropna()) # Drops NaN Value, since boxplots can't handle them.\\n\",\n",
    "    \"        plt.title(col)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Function for categorical target variable report. It shows the missingness and a plot with percentage labels.\\n\",\n",
    "    \"def univariate_target_report(df, target):\\n\",\n",
    "    \"    n = len(df)\\n\",\n",
    "    \"    missing = df[target].isna().sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Counts and calculates percentages of missing values.\\n\",\n",
    "    \"    target_counts = df[target].value_counts(dropna=False)\\n\",\n",
    "    \"    target_pct = (target_counts / n * 100).round(2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"=== Target report: {target} ===\\\")\\n\",\n",
    "    \"    print(f\\\"Rows: {n}\\\")\\n\",\n",
    "    \"    print(f\\\"Missing: {missing} ({missing / n * 100:.2f}%)\\\\n\\\")\\n\",\n",
    "    \"    print(\\\"Counts:\\\")\\n\",\n",
    "    \"    print(target_counts)\\n\",\n",
    "    \"    print(\\\"\\\\nPercentages:\\\")\\n\",\n",
    "    \"    print(target_pct.astype(str) + \\\"%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Creates a plot with percentage labels.\\n\",\n",
    "    \"    plt.figure(figsize=(6, 6))\\n\",\n",
    "    \"    ax = sns.countplot(x=target, data=df, order=target_counts.index)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Finds the correct position of the label and places the number above the bar.\\n\",\n",
    "    \"    for bar in ax.patches:\\n\",\n",
    "    \"        count = bar.get_height()\\n\",\n",
    "    \"        pct = count / n * 100\\n\",\n",
    "    \"        ax.annotate(\\n\",\n",
    "    \"            f\\\"{pct:.1f}%\\\",\\n\",\n",
    "    \"            (bar.get_x() + bar.get_width() / 2, count),\\n\",\n",
    "    \"            ha=\\\"center\\\",\\n\",\n",
    "    \"            va=\\\"bottom\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Formats the plot.\\n\",\n",
    "    \"    plt.title(f\\\"Distribution of Rain Tomorrow\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Rain Tomorrow\\\")\\n\",\n",
    "    \"    plt.ylabel(\\\"Number of observations\\\")\\n\",\n",
    "    \"    plt.grid(axis=\\\"y\\\", alpha=0.3)\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Function for EDA of numerical features. Returns number of data points, missing values and plot, descriptive statistics, skewness,\\n\",\n",
    "    \"def univariate_report_numerical(df, col, target=None, bins=30):\\n\",\n",
    "    \"    # convert column to numerical\\n\",\n",
    "    \"    s = pd.to_numeric(df[col], errors=\\\"coerce\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n = len(s)\\n\",\n",
    "    \"    missing = s.isna().sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"=== {col} (numeric) ===\\\")\\n\",\n",
    "    \"    print(f\\\"Rows: {n}\\\")\\n\",\n",
    "    \"    print(f\\\"Missing: {missing} ({missing / n * 100:.1f}%)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # basic statistics\\n\",\n",
    "    \"    desc = s.describe()\\n\",\n",
    "    \"    print(\\\"\\\\nDescriptive statistics:\\\")\\n\",\n",
    "    \"    print(desc)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # skewness\\n\",\n",
    "    \"    skew = s.skew()\\n\",\n",
    "    \"    print(f\\\"\\\\nSkewness: {skew:.2f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # missingness plot\\n\",\n",
    "    \"    plt.figure(figsize=(4, 2))\\n\",\n",
    "    \"    plt.bar([\\\"non-missing\\\", \\\"missing\\\"], [n - missing, missing])\\n\",\n",
    "    \"    plt.title(f\\\"Missingness: {col}\\\")\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # histogram\\n\",\n",
    "    \"    plt.figure(figsize=(8, 3))\\n\",\n",
    "    \"    plt.hist(s.dropna(), bins=bins)\\n\",\n",
    "    \"    plt.title(f\\\"Histogram: {col}\\\")\\n\",\n",
    "    \"    plt.xlabel(col)\\n\",\n",
    "    \"    plt.ylabel(\\\"Count\\\")\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # boxplot\\n\",\n",
    "    \"    plt.figure(figsize=(8, 1.8))\\n\",\n",
    "    \"    sns.boxplot(x=s.dropna())\\n\",\n",
    "    \"    plt.title(f\\\"Boxplot: {col}\\\")\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # IQR outlier analysis\\n\",\n",
    "    \"    q1 = s.quantile(0.25)\\n\",\n",
    "    \"    q3 = s.quantile(0.75)\\n\",\n",
    "    \"    iqr = q3 - q1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if iqr == 0:\\n\",\n",
    "    \"        print(\\\"IQR is zero → outlier detection not meaningful.\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        lower = q1 - 1.5 * iqr\\n\",\n",
    "    \"        upper = q3 + 1.5 * iqr\\n\",\n",
    "    \"        outlier_share = ((s < lower) | (s > upper)).mean() * 100\\n\",\n",
    "    \"        print(f\\\"Outliers (IQR rule): {outlier_share:.1f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # optional target split\\n\",\n",
    "    \"    if target is not None and target in df.columns:\\n\",\n",
    "    \"        tmp = df[[col, target]].copy()\\n\",\n",
    "    \"        tmp[col] = pd.to_numeric(tmp[col], errors=\\\"coerce\\\")\\n\",\n",
    "    \"        tmp = tmp.dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(tmp) > 0:\\n\",\n",
    "    \"            plt.figure(figsize=(8, 3))\\n\",\n",
    "    \"            sns.histplot(\\n\",\n",
    "    \"                data=tmp,\\n\",\n",
    "    \"                x=col,\\n\",\n",
    "    \"                hue=target,\\n\",\n",
    "    \"                bins=bins,\\n\",\n",
    "    \"                element=\\\"step\\\",\\n\",\n",
    "    \"                stat=\\\"count\\\"\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"            plt.title(f\\\"{col} split by {target}\\\")\\n\",\n",
    "    \"            plt.tight_layout()\\n\",\n",
    "    \"            plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Function for EDA of categorical features. Returns number of data points, missing values and plot, descriptive statistics, skewness,\\n\",\n",
    "    \"def univariate_report_categorical(df, col, top_k=10):\\n\",\n",
    "    \"    s = df[col].astype(\\\"string\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n = len(s)\\n\",\n",
    "    \"    missing = s.isna().sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"=== {col} (categorical) ===\\\")\\n\",\n",
    "    \"    print(f\\\"Rows: {n}\\\")\\n\",\n",
    "    \"    print(f\\\"Missing: {missing} ({missing / n * 100:.1f}%)\\\")\\n\",\n",
    "    \"    print(f\\\"Unique values: {s.nunique(dropna=False)}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    vc = s.value_counts(dropna=False).head(top_k)\\n\",\n",
    "    \"    print(f\\\"\\\\nTop {top_k} categories:\\\")\\n\",\n",
    "    \"    print(vc)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(8, 3))\\n\",\n",
    "    \"    sns.countplot(\\n\",\n",
    "    \"        x=df[col],\\n\",\n",
    "    \"        order=df[col].value_counts(dropna=False).head(top_k).index\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    plt.title(f\\\"Top categories: {col}\\\")\\n\",\n",
    "    \"    plt.xticks(rotation=30, ha=\\\"right\\\")\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Converts a location name into geographic coordinates (latitude, longitude). Returns a series with latitude and longitude, or None values if the location cannot be found.\\n\",\n",
    "    \"# location (str): Name of the location to be geocoded.\\n\",\n",
    "    \"# county (str): Country context is added to improve the accuracy, but held constant as 'Australia'\\n\",\n",
    "    \"# sleep (int): Pause in seconds between requests to avoid server overload (according to documentation).\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_geocode(location, country=\\\"Australia\\\", sleep=1):\\n\",\n",
    "    \"    loc = geolocator.geocode(f\\\"{location}, {country}\\\") # Query the Nominatim service using a string with the location and country context.\\n\",\n",
    "    \"    time.sleep(sleep)  # Pause execution to respect the rate limits.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # If the location cannot be geocoded return None.\\n\",\n",
    "    \"    if loc is None:\\n\",\n",
    "    \"        return pd.Series({\\\"Latitude\\\": None, \\\"Longitude\\\": None})\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Return the found latitude and longitude.\\n\",\n",
    "    \"    return pd.Series({\\\"Latitude\\\": loc.latitude, \\\"Longitude\\\": loc.longitude})\"\n",
    "   ],\n",
