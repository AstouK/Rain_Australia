    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"### 2.3 Definition of General Variables\",\n",
    "   \"id\": \"230a1ad7e621df56\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"target = 'RainTomorrow'\\n\",\n",
    "    \"features = [col for col in df.columns if col != target]\\n\",\n",
    "    \"\\n\",\n",
    "    \"numerical_features = [col for col in df.columns if col in features and df[col].dtype == 'float64']\\n\",\n",
    "    \"\\n\",\n",
    "    \"categorical_features = [col for col in df.columns if col in features and col not in numerical_features]\\n\",\n",
    "    \"# Removing date as categorical feature\\n\",\n",
    "    \"if \\\"Date\\\" in categorical_features:\\n\",\n",
    "    \"    categorical_features.remove(\\\"Date\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"ordinal_categorical_features = ['Cloud3pm', 'Cloud9am']\\n\",\n",
    "    \"nominal_categorical_features = list(set(categorical_features) - set(ordinal_categorical_features))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Target variable: ', target)\\n\",\n",
    "    \"print('All features: ', features)\\n\",\n",
    "    \"print('Numerical features: ', numerical_features)\\n\",\n",
    "    \"print('Categorical features: ', categorical_features)\\n\",\n",
    "    \"print('Ordinal categorical features: ', ordinal_categorical_features)\\n\",\n",
    "    \"print('Nominal categorical features: ', nominal_categorical_features)\"\n",
    "   ],\n",
    "   \"id\": \"1b6860f924d5dd3\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"#### Helper Function\",\n",
    "   \"id\": \"c2a389ddd0aba6e0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"def evaluate_model(model_name, y_true, y_pred):\\n\",\n",
    "    \"    # Detect positive class\\n\",\n",
    "    \"    positive_label = 1 if y_true.dtype != object else \\\"Yes\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    metrics = {\\n\",\n",
    "    \"        \\\"Model\\\": model_name,\\n\",\n",
    "    \"        \\\"F1\\\": f1_score(y_true, y_pred, pos_label=positive_label, zero_division=0),\\n\",\n",
    "    \"        \\\"Precision\\\": precision_score(y_true, y_pred, pos_label=positive_label, zero_division=0),\\n\",\n",
    "    \"        \\\"Recall\\\": recall_score(y_true, y_pred, pos_label=positive_label, zero_division=0),\\n\",\n",
    "    \"        \\\"BalancedAccuracy\\\": balanced_accuracy_score(y_true, y_pred)\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return metrics\\n\"\n",
    "   ],\n",
    "   \"id\": \"5099e4eceafddb79\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"<a id='section3'></a>\\n\",\n",
    "    \"## 3. Exploratory Data Analysis (EDA)\\n\",\n",
    "    \"\\n\",\n",
    "    \"We start Explorator Data Analysis (EDA) by exploring distribution, patterns and relationships between the variables.\"\n",
    "   ],\n",
    "   \"id\": \"539e39066c0930f8\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"# Copying the data frame to keep the original data. In the following section we use df_eda only.\\n\",\n",
    "    \"df_eda = df.copy()\"\n",
    "   ],\n",
    "   \"id\": \"84b165f194ab984d\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"#### Encoding Categorical Variables\\n\",\n",
    "   \"id\": \"1a3642ae8da70de4\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"def to_binary_yes_no(s: pd.Series) -> pd.Series:\\n\",\n",
    "    \"    \\\"\\\"\\\"Convert Yes/No-like series to 1/0; preserve numeric if already numeric.\\\"\\\"\\\"\\n\",\n",
    "    \"    if s.dtype == \\\"O\\\":\\n\",\n",
    "    \"        return (\\n\",\n",
    "    \"            s.astype(str)\\n\",\n",
    "    \"             .str.strip()\\n\",\n",
    "    \"             .str.lower()\\n\",\n",
    "    \"             .map({\\\"yes\\\": 1, \\\"no\\\": 0})\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    return pd.to_numeric(s, errors=\\\"coerce\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Date parsing + time features\\n\",\n",
    "    \"df_eda[\\\"Date\\\"] = pd.to_datetime(df_eda[\\\"Date\\\"], errors=\\\"coerce\\\")\\n\",\n",
    "    \"df_eda[\\\"Month\\\"] = df_eda[\\\"Date\\\"].dt.month\\n\",\n",
    "    \"df_eda[\\\"Year\\\"] = df_eda[\\\"Date\\\"].dt.year\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Binary targets used throughout EDA\\n\",\n",
    "    \"df_eda[\\\"RainTomorrow_bin\\\"] = to_binary_yes_no(df_eda[\\\"RainTomorrow\\\"])\\n\",\n",
    "    \"df_eda[\\\"RainToday_bin\\\"] = to_binary_yes_no(df_eda[\\\"RainToday\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Constants ---\\n\",\n",
