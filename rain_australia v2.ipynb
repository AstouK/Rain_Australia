    "    \"       .mul(100)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(6, 5))\\n\",\n",
    "    \"ax = plt.gca()\\n\",\n",
    "    \"ax.bar([\\\"No\\\", \\\"Yes\\\"], rate_pct.values)\\n\",\n",
    "    \"ax.set_xlabel(\\\"RainToday\\\", fontsize=12)\\n\",\n",
    "    \"ax.set_ylabel(\\\"RainTomorrow rate (%)\\\", fontsize=12)\\n\",\n",
    "    \"ax.set_title(\\\"RainTomorrow Rate by RainToday\\\", fontsize=14)\\n\",\n",
