    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def rain_rate_by_category(\\n\",\n",
    "    \"    df: pd.DataFrame,\\n\",\n",
    "    \"    cat_col: str,\\n\",\n",
    "    \"    target_col: str = \\\"RainTomorrow_bin\\\",\\n\",\n",
    "    \"    order: Optional[Iterable] = None,\\n\",\n",
    "    \"    top_n: Optional[int] = None,\\n\",\n",
    "    \"    ) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Count + RainTomorrow rate by category.\\\"\\\"\\\"\\n\",\n",
    "    \"    tmp = df[[cat_col, target_col]].dropna()\\n\",\n",
    "    \"    out = (\\n\",\n",
    "    \"        tmp.groupby(cat_col)[target_col]\\n\",\n",
    "    \"           .agg(count=\\\"size\\\", rain_rate=\\\"mean\\\")\\n\",\n",
    "    \"           .sort_values(\\\"count\\\", ascending=False)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    if top_n is not None:\\n\",\n",
    "    \"        out = out.head(top_n)\\n\",\n",
    "    \"    if order is not None:\\n\",\n",
    "    \"        out = out.reindex(list(order))\\n\",\n",
    "    \"    return out.reset_index()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _annotate_min_max_bars(ax, values, fmt=\\\"{:.1f}%\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"Annotate only min & max bar values.\\\"\\\"\\\"\\n\",\n",
    "    \"    if len(values) == 0:\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"    values = np.asarray(values, dtype=float)\\n\",\n",
    "    \"    i_min, i_max = int(np.nanargmin(values)), int(np.nanargmax(values))\\n\",\n",
    "    \"    bars = ax.patches\\n\",\n",
    "    \"    for i in {i_min, i_max}:\\n\",\n",
    "    \"        b = bars[i]\\n\",\n",
    "    \"        ax.text(\\n\",\n",
    "    \"            b.get_x() + b.get_width() / 2,\\n\",\n",
    "    \"            values[i],\\n\",\n",
    "    \"            fmt.format(values[i]),\\n\",\n",
    "    \"            ha=\\\"center\\\",\\n\",\n",
    "    \"            va=\\\"bottom\\\" if i == i_max else \\\"top\\\",\\n\",\n",
    "    \"            fontsize=10,\\n\",\n",
    "    \"            fontweight=\\\"bold\\\",\\n\",\n",
    "    \"            color=\\\"darkgreen\\\" if i == i_max else \\\"darkred\\\",\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_rate_bar(\\n\",\n",
    "    \"    rate_df: pd.DataFrame,\\n\",\n",
    "    \"    x_col: str,\\n\",\n",
    "    \"    rate_col: str = \\\"rain_rate\\\",\\n\",\n",
    "    \"    title: str = \\\"\\\",\\n\",\n",
    "    \"    xlabel: str = \\\"\\\",\\n\",\n",
    "    \"    ylabel: str = \\\"RainTomorrow rate (%)\\\",\\n\",\n",
    "    \"    rotate: int = 45,\\n\",\n",
    "    \"    figsize: Tuple[int, int] = (12, 6),\\n\",\n",
    "    \"    annotate_min_max: bool = True,\\n\",\n",
    "    \"    ):\\n\",\n",
    "    \"    \\\"\\\"\\\"Simple bar chart for rates (0–1 or 0–100).\\\"\\\"\\\"\\n\",\n",
    "    \"    d = rate_df.copy()\\n\",\n",
    "    \"    y = d[rate_col].astype(float)\\n\",\n",
    "    \"    if y.max() <= 1.01:\\n\",\n",
    "    \"        y = y * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=figsize)\\n\",\n",
    "    \"    ax = plt.gca()\\n\",\n",
    "    \"    ax.bar(d[x_col].astype(str), y.values)\\n\",\n",
    "    \"    ax.set_title(title, fontsize=14)\\n\",\n",
    "    \"    ax.set_xlabel(xlabel, fontsize=12)\\n\",\n",
    "    \"    ax.set_ylabel(ylabel, fontsize=12)\\n\",\n",
    "    \"    ax.yaxis.set_major_formatter(PercentFormatter())\\n\",\n",
    "    \"    ax.grid(axis=\\\"y\\\", alpha=0.3)\\n\",\n",
    "    \"    plt.xticks(rotation=rotate, ha=\\\"right\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if annotate_min_max:\\n\",\n",
    "    \"        _annotate_min_max_bars(ax, y.values)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def polar_rain_rate(ax, df: pd.DataFrame, dir_col: str, order: Iterable, title: str):\\n\",\n",
    "    \"    \\\"\\\"\\\"Polar bar chart: RainTomorrow rate (%) by wind direction.\\\"\\\"\\\"\\n\",\n",
    "    \"    tmp = df[[dir_col, \\\"RainTomorrow_bin\\\"]].dropna()\\n\",\n",
    "    \"    rate_pct = (\\n\",\n",
    "    \"        tmp.groupby(dir_col)[\\\"RainTomorrow_bin\\\"]\\n\",\n",
    "    \"           .mean()\\n\",\n",
    "    \"           .reindex(list(order))\\n\",\n",
    "    \"           .fillna(0)\\n\",\n",
    "    \"           .mul(100)\\n\",\n",
    "    \"           .values\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n = len(order)\\n\",\n",
    "    \"    angles = np.linspace(0, 2*np.pi, n, endpoint=False)\\n\",\n",
    "    \"    width = 2*np.pi / n\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.bar(angles, rate_pct, width=width, align=\\\"center\\\", alpha=0.85)\\n\",\n",
    "    \"    ax.set_theta_zero_location(\\\"N\\\")\\n\",\n",
    "    \"    ax.set_theta_direction(-1)\\n\",\n",
    "    \"    ax.set_xticks(angles)\\n\",\n",
    "    \"    ax.set_xticklabels(list(order), fontsize=9)\\n\",\n",
    "    \"    ax.set_title(title, fontsize=13, pad=18)\\n\",\n",
    "    \"    ax.set_yticklabels([])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # annotate only min/max\\n\",\n",
    "    \"    i_min, i_max = int(np.argmin(rate_pct)), int(np.argmax(rate_pct))\\n\",\n",
    "    \"    for i, col in [(i_min, \\\"darkred\\\"), (i_max, \\\"darkgreen\\\")]:\\n\",\n",
    "    \"        ax.text(\\n\",\n",
    "    \"            angles[i],\\n\",\n",
    "    \"            rate_pct[i] + 1.5,\\n\",\n",
    "    \"            f\\\"{rate_pct[i]:.1f}%\\\",\\n\",\n",
    "    \"            ha=\\\"center\\\",\\n\",\n",
    "    \"            va=\\\"bottom\\\",\\n\",\n",
    "    \"            fontsize=12,\\n\",\n",
    "    \"            fontweight=\\\"bold\\\",\\n\",\n",
    "    \"            color=col\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_cloud_rate(ax, df: pd.DataFrame, cloud_col: str, title: str):\\n\",\n",
    "    \"    \\\"\\\"\\\"Bar chart: RainTomorrow rate (%) by cloud (numeric 0–8 or text buckets).\\\"\\\"\\\"\\n\",\n",
    "    \"    d = df[[cloud_col, \\\"RainTomorrow_bin\\\"]].dropna().copy()\\n\",\n",
    "    \"    cloud_num = pd.to_numeric(d[cloud_col], errors=\\\"coerce\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if cloud_num.notna().mean() > 0.8:\\n\",\n",
    "    \"        d[cloud_col] = cloud_num\\n\",\n",
    "    \"        order = list(range(0, 9))\\n\",\n",
    "    \"        x = order\\n\",\n",
    "    \"        rate_pct = (\\n\",\n",
    "    \"            d.groupby(cloud_col)[\\\"RainTomorrow_bin\\\"]\\n\",\n",
    "    \"             .mean()\\n\",\n",
    "    \"             .reindex(order)\\n\",\n",
    "    \"             .mul(100)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        bars = ax.bar(x, rate_pct.values)\\n\",\n",
    "    \"        ax.set_xticks(x)\\n\",\n",
    "    \"        ax.set_xlabel(f\\\"{cloud_col} (0–8 oktas)\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        order = CLOUD_TEXT_ORDER\\n\",\n",
    "    \"        rate_pct = (\\n\",\n",
    "    \"            d.groupby(cloud_col)[\\\"RainTomorrow_bin\\\"]\\n\",\n",
    "    \"             .mean()\\n\",\n",
    "    \"             .reindex(order)\\n\",\n",
    "    \"             .dropna()\\n\",\n",
    "    \"             .mul(100)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        bars = ax.bar(rate_pct.index.astype(str), rate_pct.values)\\n\",\n",
    "    \"        ax.tick_params(axis=\\\"x\\\", rotation=30)\\n\",\n",
    "    \"        ax.set_xlabel(cloud_col)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_title(title, fontsize=13)\\n\",\n",
    "    \"    ax.yaxis.set_major_formatter(PercentFormatter())\\n\",\n",
    "    \"    ax.grid(axis=\\\"y\\\", alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # annotate only min/max\\n\",\n",
    "    \"    if len(rate_pct) > 0:\\n\",\n",
    "    \"        i_min, i_max = int(np.nanargmin(rate_pct.values)), int(np.nanargmax(rate_pct.values))\\n\",\n",
    "    \"        offset = float(np.nanmax(rate_pct.values)) * 0.01\\n\",\n",
    "    \"        for i, col in [(i_min, \\\"darkred\\\"), (i_max, \\\"darkgreen\\\")]:\\n\",\n",
    "    \"            ax.text(\\n\",\n",
    "    \"                bars[i].get_x() + bars[i].get_width() / 2,\\n\",\n",
    "    \"                rate_pct.values[i] + offset,\\n\",\n",
    "    \"                f\\\"{rate_pct.values[i]:.1f}%\\\",\\n\",\n",
    "    \"                ha=\\\"center\\\",\\n\",\n",
    "    \"                va=\\\"bottom\\\",\\n\",\n",
    "    \"                fontsize=9,\\n\",\n",
    "    \"                fontweight=\\\"bold\\\",\\n\",\n",
    "    \"                color=col,\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"def binned_rate_curve(\\n\",\n",
    "    \"    df: pd.DataFrame,\\n\",\n",
    "    \"    feature: str,\\n\",\n",
    "    \"    target_col: str = \\\"RainTomorrow_bin\\\",\\n\",\n",
    "    \"    q: int = 10,\\n\",\n",
    "    \"    ) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Return binned rate curve with x-midpoint + rate (%).\\\"\\\"\\\"\\n\",\n",
    "    \"    d = df[[feature, target_col]].copy()\\n\",\n",
    "    \"    d[feature] = pd.to_numeric(d[feature], errors=\\\"coerce\\\")\\n\",\n",
    "    \"    d[target_col] = pd.to_numeric(d[target_col], errors=\\\"coerce\\\")\\n\",\n",
    "    \"    d = d.dropna()\\n\",\n",
    "    \"    if d.empty or d[feature].nunique() <= 1:\\n\",\n",
    "    \"        return pd.DataFrame(columns=[\\\"x_mid\\\", \\\"rate_pct\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if feature.lower() == \\\"rainfall\\\":\\n\",\n",
    "    \"        upper = max(float(d[feature].max()), 20.0)\\n\",\n",
    "    \"        bins = [-0.1, 0, 1, 5, 20, upper]\\n\",\n",
    "    \"        d[\\\"bin\\\"] = pd.cut(d[feature], bins=bins, include_lowest=True)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        d[\\\"bin\\\"] = pd.qcut(d[feature], q=q, duplicates=\\\"drop\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rate = (\\n\",\n",
    "    \"        d.groupby(\\\"bin\\\")[target_col]\\n\",\n",
    "    \"         .mean()\\n\",\n",
    "    \"         .mul(100)\\n\",\n",
    "    \"         .reset_index(name=\\\"rate_pct\\\")\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    rate[\\\"x_mid\\\"] = rate[\\\"bin\\\"].apply(lambda b: (b.left + b.right) / 2)\\n\",\n",
    "    \"    return rate[[\\\"x_mid\\\", \\\"rate_pct\\\"]]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_rate_curve(ax, curve_df: pd.DataFrame, title: str):\\n\",\n",
    "    \"    if curve_df.empty:\\n\",\n",
    "    \"        ax.set_title(f\\\"{title} (insufficient data)\\\")\\n\",\n",
    "    \"        ax.axis(\\\"off\\\")\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.plot(curve_df[\\\"x_mid\\\"], curve_df[\\\"rate_pct\\\"], marker=\\\"o\\\", linewidth=2)\\n\",\n",
    "    \"    ax.set_title(title, fontsize=14)\\n\",\n",
    "    \"    ax.set_ylabel(\\\"RainTomorrow rate (%)\\\", fontsize=10)\\n\",\n",
    "    \"    ax.yaxis.set_major_formatter(PercentFormatter())\\n\",\n",
    "    \"    ax.grid(axis=\\\"y\\\", alpha=0.3)\\n\",\n",
    "    \"    ax.set_ylim(0, 100)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # annotate min/max\\n\",\n",
    "    \"    i_min = int(curve_df[\\\"rate_pct\\\"].idxmin())\\n\",\n",
    "    \"    i_max = int(curve_df[\\\"rate_pct\\\"].idxmax())\\n\",\n",
    "    \"    for i, dy, col in [(i_max, 6, \\\"darkgreen\\\"), (i_min, -12, \\\"darkred\\\")]:\\n\",\n",
    "    \"        ax.annotate(\\n\",\n",
    "    \"            f\\\"{curve_df.loc[i, 'rate_pct']:.1f}%\\\",\\n\",\n",
    "    \"            (curve_df.loc[i, \\\"x_mid\\\"], curve_df.loc[i, \\\"rate_pct\\\"]),\\n\",\n",
    "    \"            textcoords=\\\"offset points\\\",\\n\",\n",
    "    \"            xytext=(0, dy),\\n\",\n",
    "    \"            ha=\\\"center\\\",\\n\",\n",
    "    \"            fontsize=10,\\n\",\n",
    "    \"            fontweight=\\\"bold\\\",\\n\",\n",
    "    \"            color=col,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_rate_curves_grid(\\n\",\n",
    "    \"    df: pd.DataFrame,\\n\",\n",
    "    \"    features: Optional[Iterable[str]] = None,\\n\",\n",
    "    \"    target_col: str = \\\"RainTomorrow_bin\\\",\\n\",\n",
    "    \"    q: int = 10,\\n\",\n",
    "    \"    n_cols: int = 4,\\n\",\n",
    "    \"    figsize: Tuple[int, int] = (30, 15),\\n\",\n",
    "    \"    suptitle: str = \\\"RainTomorrow Rate by Numerical Features\\\",\\n\",\n",
    "    \"    ):\\n\",\n",
    "    \"    \\\"\\\"\\\"Grid of binned rate curves for numeric features.\\\"\\\"\\\"\\n\",\n",
    "    \"    if features is None:\\n\",\n",
    "    \"        features = [\\n\",\n",
    "    \"            c for c in df.select_dtypes(include=[np.number]).columns\\n\",\n",
    "    \"            if c not in {target_col, \\\"RainToday_bin\\\"}\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"    features = list(features)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    curves = [(f, binned_rate_curve(df, f, target_col=target_col, q=q)) for f in features]\\n\",\n",
    "    \"    curves = [(f, c) for f, c in curves if not c.empty]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n_plots = len(curves)\\n\",\n",
    "    \"    n_rows = int(np.ceil(n_plots / n_cols)) if n_plots else 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(n_rows, n_cols, figsize=figsize)\\n\",\n",
    "    \"    axes = np.array(axes).reshape(n_rows, n_cols)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i, (feat, curve) in enumerate(curves):\\n\",\n",
    "    \"        ax = axes[i // n_cols, i % n_cols]\\n\",\n",
    "    \"        plot_rate_curve(ax, curve, feat)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for j in range(n_plots, n_rows * n_cols):\\n\",\n",
    "    \"        axes[j // n_cols, j % n_cols].axis(\\\"off\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig.suptitle(suptitle, fontsize=16)\\n\",\n",
    "    \"    plt.tight_layout(rect=[0, 0, 1, 0.96])\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def folium_bubble_map(\\n\",\n",
    "    \"    df: pd.DataFrame,\\n\",\n",
    "    \"    lat_col: str,\\n\",\n",
    "    \"    lon_col: str,\\n\",\n",
    "    \"    size_col: str,\\n\",\n",
    "    \"    popup_col: str,\\n\",\n",
    "    \"    location: Tuple[float, float] = (-25.2744, 133.7751),\\n\",\n",
    "    \"    zoom_start: int = 5,\\n\",\n",
    "    \"    radius_range: Tuple[int, int] = (4, 30),\\n\",\n",
    "    \"    ):\\n\",\n",
    "    \"    \\\"\\\"\\\"Folium bubble map with size normalized from size_col.\\\"\\\"\\\"\\n\",\n",
    "    \"    d = df.dropna(subset=[lat_col, lon_col, size_col]).copy()\\n\",\n",
    "    \"    if d.empty:\\n\",\n",
    "    \"        return folium.Map(location=list(location), zoom_start=zoom_start)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    scaler = MinMaxScaler(feature_range=radius_range)\\n\",\n",
    "    \"    d[\\\"_radius_\\\"] = scaler.fit_transform(d[[size_col]])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    m = folium.Map(location=list(location), zoom_start=zoom_start)\\n\",\n",
    "    \"    for _, row in d.iterrows():\\n\",\n",
    "    \"        folium.CircleMarker(\\n\",\n",
    "    \"            location=[row[lat_col], row[lon_col]],\\n\",\n",
    "    \"            radius=float(row[\\\"_radius_\\\"]),\\n\",\n",
    "    \"            fill=True,\\n\",\n",
    "    \"            fill_opacity=0.7,\\n\",\n",
    "    \"            weight=1,\\n\",\n",
    "    \"            popup=str(row[popup_col]),\\n\",\n",
    "    \"        ).add_to(m)\\n\",\n",
    "    \"    return m\"\n",
    "   ],\n",
