    "    \"# Nils Becker (03817505)\\n\",\n",
    "    \"# Since the outlier share of Rainfall exceeds the 2% threshold, defined in EDA's introduction, we use IQR-based capping for better visualization.\\n\",\n",
    "    \"# To improve the interpretability of the distribution, extreme rainfall values are identified using the one-sided IQR 1.5 method. Observation above this threshold are therefore excluded.\\n\",\n",
    "    \"q1 = df[\\\"Rainfall\\\"].quantile(0.25)\\n\",\n",
    "    \"q3 = df[\\\"Rainfall\\\"].quantile(0.75)\\n\",\n",
    "    \"iqr = q3 - q1\\n\",\n",
    "    \"\\n\",\n",
    "    \"upper = q3 + 1.5 * iqr\\n\",\n",
    "    \"\\n\",\n",
    "    \"univariate_report_numerical(df_eda[df_eda['Rainfall'] <= upper], col='Rainfall')\"\n",
