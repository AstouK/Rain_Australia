    "   \"source\": [\n",
    "    \"# Define compass order for wind directions\\n\",\n",
    "    \"WindDir3pm_order = [\\n\",\n",
    "    \"    'N', 'NNE', 'NE', 'ENE',\\n\",\n",
    "    \"    'E', 'ESE', 'SE', 'SSE',\\n\",\n",
    "    \"    'S', 'SSW', 'SW', 'WSW',\\n\",\n",
    "    \"    'W', 'WNW', 'NW', 'NNW'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Count occurrences of each wind gust direction\\n\",\n",
    "    \"dir_counts = (\\n\",\n",
    "    \"    df_eda[\\\"WindDir3pm\\\"]\\n\",\n",
    "    \"    .value_counts()\\n\",\n",
    "    \"    .reindex(WindDir3pm_order)\\n\",\n",
    "    \"    .fillna(0)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prepare polar coordinates\\n\",\n",
    "    \"n_dirs = len(WindDir3pm_order)\\n\",\n",
    "    \"angles = np.linspace(0, 2 * np.pi, n_dirs, endpoint=False)\\n\",\n",
    "    \"heights = dir_counts.values\\n\",\n",
    "    \"width = 2 * np.pi / n_dirs\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create polar plot\\n\",\n",
    "    \"plt.figure(figsize=(8, 8))\\n\",\n",
    "    \"ax = plt.subplot(111, polar=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.bar(angles, heights, width=width, align=\\\"center\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compass-style orientation\\n\",\n",
    "    \"ax.set_theta_zero_location(\\\"N\\\")   # North at the top\\n\",\n",
    "    \"ax.set_theta_direction(-1)        # Clockwise rotation\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_xticks(angles)\\n\",\n",
    "    \"ax.set_xticklabels(WindDir3pm_order)\\n\",\n",
    "    \"ax.set_yticklabels([])\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title(\\n\",\n",
    "    \"    \\\"Distribution of Wind Direction at 3pm\\\",\\n\",\n",
    "    \"    fontsize=14,\\n\",\n",
    "    \"    pad=20\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
