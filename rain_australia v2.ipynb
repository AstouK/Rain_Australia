    "    \"    \\\"N\\\",\\\"NNE\\\",\\\"NE\\\",\\\"ENE\\\",\\n\",\n",
    "    \"    \\\"E\\\",\\\"ESE\\\",\\\"SE\\\",\\\"SSE\\\",\\n\",\n",
