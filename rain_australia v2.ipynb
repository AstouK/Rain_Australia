    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"tmp = df_eda[[\\\"RainToday_bin\\\", \\\"RainTomorrow_bin\\\"]].dropna()\\n\",\n",
