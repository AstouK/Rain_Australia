    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def inspect_dataframe(df, top_n=5):\\n\",\n",
    "    \"    summary = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for col in df.columns:\\n\",\n",
    "    \"        series = df[col]\\n\",\n",
    "    \"        dtype = series.dtype\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Cardinality\\n\",\n",
    "    \"        cardinality = series.nunique(dropna=True)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Most common values\\n\",\n",
    "    \"        common_vals = series.value_counts(dropna=False).head(top_n)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Heuristic: numeric or categorical?\\n\",\n",
    "    \"        if pd.api.types.is_numeric_dtype(series):\\n\",\n",
    "    \"            inferred_type = \\\"numeric\\\"\\n\",\n",
    "    \"        elif pd.api.types.is_datetime64_any_dtype(series):\\n\",\n",
    "    \"            inferred_type = \\\"datetime\\\"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            # For object/string columns, check cardinality ratio\\n\",\n",
    "    \"            ratio = cardinality / len(series)\\n\",\n",
    "    \"            inferred_type = \\\"categorical\\\" if ratio < 0.5 else \\\"high‑cardinality text\\\"\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        summary.append({\\n\",\n",
    "    \"            \\\"column\\\": col,\\n\",\n",
    "    \"            \\\"dtype\\\": str(dtype),\\n\",\n",
    "    \"            \\\"cardinality\\\": cardinality,\\n\",\n",
    "    \"            \\\"inferred_type\\\": inferred_type,\\n\",\n",
    "    \"            \\\"most_common\\\": common_vals.to_dict()\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return pd.DataFrame(summary)\\n\",\n",
    "    \"\\n\",\n",
    "    \"inspect_dataframe(df)\\n\"\n",
    "   ],\n",
