    "   \"id\": \"6b66c4afba052f83\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"plot_rate_curves_grid(\\n\",\n",
    "    \"    df_eda,\\n\",\n",
    "    \"    target_col=\\\"RainTomorrow_bin\\\",\\n\",\n",
    "    \"    q=10,\\n\",\n",
    "    \"    n_cols=4,\\n\",\n",
    "    \"    figsize=(30, 15),\\n\",\n",
    "    \")\"\n",
    "   ],\n",
